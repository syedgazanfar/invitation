# Django Settings
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=invitation_platform
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0        # Celery broker & result backend
REDIS_CACHE_URL=redis://localhost:6379/1  # Django cache (separate DB to avoid key collisions)

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend URL (for invitation links)
FRONTEND_URL=http://localhost:3000

# Fingerprint Salt (change in production)
FINGERPRINT_SALT=your-secret-salt-here

# Admin Settings
ADMIN_COMPANY_NAME=Digital Invitation Platform
ADMIN_SUPPORT_EMAIL=support@example.com

# Email Settings (for notifications - optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# AWS S3 Settings (for production file storage - optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
USE_S3=False

# Razorpay Payment (Required for automatic payments)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# MSG91 SMS (Required for OTP)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=INVITE
MSG91_ROUTE=4
MSG91_TEMPLATE_ID=your_template_id

# AI Services
OPENAI_API_KEY=sk-...
GOOGLE_VISION_API_KEY=
AI_MOCK_MODE=True   # Set False in production with real API keys

# Sentry — Error tracking (optional but recommended in production)
SENTRY_DSN=

# WA-AKG WhatsApp gateway (enquiry form notifications)
# 1. Open the WA-AKG dashboard (http://localhost:3001), log in, scan the QR code to connect WhatsApp
# 2. Copy the session id, and create an API key under Settings -> API Keys
WA_AKG_BASE_URL=http://wa-gateway:3000/api
WA_AKG_API_KEY=wag_your_api_key
WA_AKG_SESSION_ID=your_session_id
WA_AKG_ADMIN_NUMBERS=+919876543210        # comma-separated numbers that receive new enquiries
WA_AKG_SEND_CUSTOMER_CONFIRMATION=True    # send the enquirer a "thanks, we'll be in touch" message
ENQUIRY_BRAND_NAME=Our team
ENQUIRY_THROTTLE_RATE=5/hour              # per-IP limit on enquiry submissions
