# Production settings for docker-compose.prod.yml
#   cp .env.production.example .env   (then replace every value below)
# Generate secrets with:  openssl rand -hex 32
# Note: no inline comments after values, docker compose would read them as part of the value.

# --- Your domains -------------------------------------------------------------
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
FRONTEND_URL=https://yourdomain.com
# Baked into the frontend at build time; rebuild the frontend after changing it
PUBLIC_API_URL=https://yourdomain.com/api/v1

# --- Django secrets -----------------------------------------------------------
SECRET_KEY=replace-with-a-long-random-string
DB_PASSWORD=replace-with-a-strong-password
FINGERPRINT_SALT=replace-with-a-long-random-string

# --- Payments / SMS / AI (optional, leave blank if unused) --------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
OPENAI_API_KEY=
AI_MOCK_MODE=True
SENTRY_DSN=

# --- WA-AKG WhatsApp gateway ---------------------------------------------------
WA_BASE_URL=https://wa.yourdomain.com
WA_AUTH_SECRET=replace-with-a-long-random-string
WA_MYSQL_ROOT_PASSWORD=replace-with-a-strong-password
WA_ADMIN_EMAIL=you@yourdomain.com
WA_ADMIN_PASSWORD=replace-with-a-strong-password

# Fill these in after connecting WhatsApp in the WA-AKG dashboard (see DEPLOY.md step 6)
WA_AKG_API_KEY=
WA_AKG_SESSION_ID=
# Comma-separated numbers that receive new enquiries, e.g. +919876543210,+919812345678
WA_AKG_ADMIN_NUMBERS=
WA_AKG_SEND_CUSTOMER_CONFIRMATION=True
ENQUIRY_BRAND_NAME=Our team
